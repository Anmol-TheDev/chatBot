meta {
  name: Get QA by ID
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/qa/{{qaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("should return QA by ID", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.qa).to.have.property("_id");
    expect(res.getBody().data.qa).to.have.property("question");
    expect(res.getBody().data.qa).to.have.property("answer");
  });
}

docs {
  # Get Q&A by ID
  
  Retrieve a specific Q&A pair by its ID.
  
  **Authentication Required:** Admin JWT token
  
  ## URL Parameters
  - `id` (string): MongoDB ObjectId of the Q&A pair
  
  ## Success Response (200)
  ```json
  {
    "status": "success",
    "data": {
      "qa": {
        "_id": "64f8a1b2c3d4e5f6a7b8c9d0",
        "question": "What is the purpose of this chatbot?",
        "answer": "This chatbot is designed to help users with document-based question answering.",
        "createdAt": "2024-01-01T00:00:00.000Z",
        "updatedAt": "2024-01-01T00:00:00.000Z"
      }
    }
  }
  ```
  
  ## Error Response (404)
  ```json
  {
    "status": "fail",
    "message": "Q&A not found"
  }
  ```
}