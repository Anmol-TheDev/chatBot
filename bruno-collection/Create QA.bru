meta {
  name: Create QA
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/qa
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "question": "What is the purpose of this chatbot?",
    "answer": "This chatbot is designed to help users with document-based question answering. It can process uploaded documents and provide relevant answers based on the content."
  }
}

tests {
  test("should create QA successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.have.property("id");
    expect(res.getBody().data).to.have.property("question");
    expect(res.getBody().data).to.have.property("answer");
  });
}

docs {
  # Create Q&A Pair
  
  Create a new question-answer pair in the system.
  
  **Authentication Required:** Admin JWT token
  
  ## Request Body
  ```json
  {
    "question": "What is the purpose of this chatbot?",
    "answer": "This chatbot is designed to help users with document-based question answering."
  }
  ```
  
  ## Success Response (201)
  ```json
  {
    "status": "success",
    "message": "QA created successfully",
    "data": {
      "id": "qa_1704067200000",
      "question": "What is the purpose of this chatbot?",
      "answer": "This chatbot is designed to help users with document-based question answering.",
      "createdAt": "2024-01-01T00:00:00.000Z"
    }
  }
  ```
  
  ## Error Response (400)
  ```json
  {
    "status": "fail",
    "message": "Question and answer are required"
  }
  ```
}