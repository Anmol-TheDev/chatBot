delete {
  url: {{baseUrl}}/api/qa/{{qaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("should delete QA successfully", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  # Delete Q&A Pair
  
  Delete a specific question-answer pair from the system.
  
  **Authentication Required:** Admin JWT token
  
  ## URL Parameters
  - `id` (string): MongoDB ObjectId of the Q&A pair to delete
  
  ## Success Response (204)
  No content returned on successful deletion.
  
  ## Error Response (404)
  ```json
  {
    "status": "fail",
    "message": "Q&A not found"
  }
  ```
}