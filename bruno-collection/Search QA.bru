meta {
  name: Search QA
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/qa/search?q=chatbot&limit=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:query {
  q: chatbot
  limit: 5
}

tests {
  test("should return search results", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.qaPairs).to.be.an("array");
    expect(res.getBody()).to.have.property("results");
  });
}

docs {
  # Search Q&A Pairs
  
  Search for Q&A pairs by question or answer content.
  
  **Authentication Required:** Admin JWT token
  
  ## Query Parameters
  - `q` (string, required): Search query term
  - `limit` (number, optional): Maximum number of results (default: 5)
  
  ## Success Response (200)
  ```json
  {
    "status": "success",
    "results": 2,
    "data": {
      "qaPairs": [
        {
          "_id": "64f8a1b2c3d4e5f6a7b8c9d0",
          "question": "What is the purpose of this chatbot?",
          "answer": "This chatbot is designed to help users with document-based question answering.",
          "createdAt": "2024-01-01T00:00:00.000Z",
          "updatedAt": "2024-01-01T00:00:00.000Z"
        }
      ]
    }
  }
  ```
  
  ## Error Response (400)
  ```json
  {
    "status": "fail",
    "message": "Search query is required"
  }
  ```
}