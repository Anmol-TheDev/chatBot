meta {
  name: Upload Document
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/documents/upload
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:multipart-form {
  document: @file(/path/to/your/document.pdf)
}

tests {
  test("should upload document successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.document).to.have.property("id");
    expect(res.getBody().data.document).to.have.property("fileName");
    expect(res.getBody().data.document).to.have.property("filePath");
  });
}

docs {
  # Upload Document
  
  Upload a document file to the system. Files are stored on Cloudinary.
  
  **Authentication Required:** Admin JWT token
  
  ## Request
  - **Content-Type:** multipart/form-data
  - **Field Name:** document
  - **Supported Types:** PDF, DOC, DOCX, TXT, MD
  - **Max Size:** 10MB
  
  ## Success Response (201)
  ```json
  {
    "status": "success",
    "message": "Document uploaded successfully",
    "data": {
      "document": {
        "id": "64f8a1b2c3d4e5f6a7b8c9d0",
        "fileName": "example.pdf",
        "fileType": "pdf",
        "filePath": "https://res.cloudinary.com/your-cloud/raw/upload/v1234567890/chatbot-documents/document-123456789.pdf",
        "extractedText": "Preview of extracted text...",
        "uploadedAt": "2024-01-01T00:00:00.000Z"
      }
    }
  }
  ```
  
  ## Error Responses
  
  ### No File (400)
  ```json
  {
    "status": "fail",
    "message": "No file uploaded. Please select a file to upload."
  }
  ```
  
  ### Invalid File Type (400)
  ```json
  {
    "status": "fail",
    "message": "File type .exe is not allowed. Allowed types: .pdf, .doc, .docx, .txt, .md"
  }
  ```
  
  ### File Too Large (400)
  ```json
  {
    "status": "fail",
    "message": "File too large. Maximum size allowed is 10MB"
  }
  ```
}