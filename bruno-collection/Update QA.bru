meta {
  name: Update QA
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/qa/{{qaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "question": "What is the main purpose of this chatbot system?",
    "answer": "This chatbot system is designed to help users with intelligent document-based question answering. It can process uploaded documents, extract text content, and provide relevant answers based on the stored knowledge base."
  }
}

tests {
  test("should update QA successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.qa).to.have.property("_id");
    expect(res.getBody().data.qa.question).to.include("main purpose");
  });
}

docs {
  # Update Q&A Pair
  
  Update an existing Q&A pair. You can update either the question, answer, or both.
  
  **Authentication Required:** Admin JWT token
  
  ## URL Parameters
  - `id` (string): MongoDB ObjectId of the Q&A pair to update
  
  ## Request Body
  ```json
  {
    "question": "Updated question text (optional)",
    "answer": "Updated answer text (optional)"
  }
  ```
  
  ## Success Response (200)
  ```json
  {
    "status": "success",
    "message": "Q&A updated successfully",
    "data": {
      "qa": {
        "_id": "64f8a1b2c3d4e5f6a7b8c9d0",
        "question": "What is the main purpose of this chatbot system?",
        "answer": "This chatbot system is designed to help users with intelligent document-based question answering.",
        "createdAt": "2024-01-01T00:00:00.000Z",
        "updatedAt": "2024-01-01T00:30:00.000Z"
      }
    }
  }
  ```
  
  ## Error Responses
  
  ### No Fields Provided (400)
  ```json
  {
    "status": "fail",
    "message": "At least one field (question or answer) is required for update"
  }
  ```
  
  ### Q&A Not Found (404)
  ```json
  {
    "status": "fail",
    "message": "Q&A not found"
  }
  ```
  
  ### Duplicate Question (400)
  ```json
  {
    "status": "fail",
    "message": "A Q&A with this question already exists"
  }
  ```
}