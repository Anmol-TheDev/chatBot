meta {
  name: Get Document by ID
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/documents/64f8a1b2c3d4e5f6a7b8c9d0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("should return document with full details", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.document).to.have.property("extractedText");
  });
}

docs {
  # Get Document by ID
  
  Retrieve a specific document by its ID, including the full extracted text.
  
  **Authentication Required:** Admin JWT token
  
  ## URL Parameters
  - `id` (string): MongoDB ObjectId of the document
  
  ## Success Response (200)
  ```json
  {
    "status": "success",
    "data": {
      "document": {
        "_id": "64f8a1b2c3d4e5f6a7b8c9d0",
        "fileName": "example.pdf",
        "fileType": "pdf",
        "filePath": "https://res.cloudinary.com/your-cloud/raw/upload/v1234567890/chatbot-documents/document-123456789.pdf",
        "cloudinaryId": "chatbot-documents/document-123456789",
        "extractedText": "Full extracted text content from the document...",
        "uploadedAt": "2024-01-01T00:00:00.000Z",
        "createdAt": "2024-01-01T00:00:00.000Z",
        "updatedAt": "2024-01-01T00:00:00.000Z"
      }
    }
  }
  ```
  
  ## Error Response (404)
  ```json
  {
    "status": "fail",
    "message": "Document not found"
  }
  ```
}